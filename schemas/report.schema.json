{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCB Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["design_revision", "profile_id", "overall_status", "findings"],
  "properties": {
    "design_revision": {"$ref": "#/$defs/text"},
    "profile_id": {"$ref": "#/$defs/id"},
    "overall_status": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_EVALUATED"]},
    "scope_criteria": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"}
    },
    "evidence_artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"$ref": "#/$defs/text"},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"findings": {"contains": {"properties": {"status": {"const": "FAIL"}}}}}},
      "then": {"properties": {"overall_status": {"const": "FAIL"}}},
      "else": {"properties": {"overall_status": {"not": {"const": "FAIL"}}}}
    },
    {
      "if": {"properties": {"overall_status": {"const": "PASS"}}},
      "then": {
        "required": ["scope_criteria"],
        "properties": {
          "findings": {
            "contains": {"properties": {"status": {"const": "PASS"}}},
            "items": {"properties": {"status": {"enum": ["PASS", "N_A"]}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"overall_status": {"const": "NOT_EVALUATED"}}},
      "then": {"properties": {"findings": {"items": {"properties": {"status": {"enum": ["NOT_EVALUATED", "N_A"]}}}}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "nullable_text": {"type": ["string", "null"]},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "waiver": {
      "type": "object",
      "required": ["id", "owner", "reason", "design_revision", "expires_on"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "owner": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "design_revision": {"$ref": "#/$defs/text"},
        "expires_on": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["rule_id", "status", "evidence"],
      "dependentRequired": {
        "criterion_id": ["object_id"],
        "measurement": ["criterion_id", "evidence_ref"],
        "assessment": ["criterion_id", "evidence_ref"]
      },
      "dependentSchemas": {
        "waiver": {"properties": {"status": {"const": "FAIL"}}}
      },
      "properties": {
        "rule_id": {"type": "string", "pattern": "^PCB-[A-Z]+-[0-9]{3}$"},
        "status": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_EVALUATED", "N_A"]},
        "severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3", null]},
        "refdes": {"$ref": "#/$defs/nullable_text"},
        "net": {"$ref": "#/$defs/nullable_text"},
        "layer": {"$ref": "#/$defs/nullable_text"},
        "evidence": {"$ref": "#/$defs/text"},
        "criterion_source": {"$ref": "#/$defs/nullable_text"},
        "confidence": {"$ref": "#/$defs/nullable_text"},
        "remediation": {"$ref": "#/$defs/nullable_text"},
        "verification": {"$ref": "#/$defs/nullable_text"},
        "criterion_id": {"$ref": "#/$defs/id"},
        "object_id": {"$ref": "#/$defs/id"},
        "waiver": {"$ref": "#/$defs/waiver"},
        "evidence_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "locator"],
          "properties": {
            "artifact": {"$ref": "#/$defs/text"},
            "locator": {"$ref": "#/$defs/text"}
          }
        },
        "assessment": {"enum": ["satisfied", "not_satisfied"]},
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": "number", "minimum": 0},
            "unit": {"enum": ["mm", "ohm"]}
          }
        }
      },
      "if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}}},
      "then": {
        "required": ["criterion_id", "object_id", "evidence_ref", "verification"],
        "oneOf": [{"required": ["measurement"]}, {"required": ["assessment"]}],
        "properties": {"verification": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
