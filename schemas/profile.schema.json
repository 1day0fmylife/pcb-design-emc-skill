{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCB Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "description",
    "inherits",
    "feature_tags",
    "constraints",
    "approved"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inherits": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "feature_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_trace_width_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "min_copper_gap_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "copper_to_edge_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "min_drill_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "controlled_impedance_ohm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "working_voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_current_a": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
